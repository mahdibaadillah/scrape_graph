        "pythonCode": "# Get the workflow ID selected by the comparison\nworkflow_id = _('If n8n before GitHub1').first().json['same']['id']\n\n# Get all decoded GitHub workflow items\nall_decoded = _('Decode to json1').all()\n\n# Find the matching workflow\nmatched = [\n    item.json\n    for item in all_decoded\n    if item.json.get('id') == workflow_id\n]\n\nif matched:\n    return [{'json': {'dataset': matched[0]}}]\nelse:\n    return []\n"
      },
